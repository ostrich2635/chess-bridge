{
  "manifest_version": 3,
  "name": "Chess Analysis Bridge (Chess.com → Lichess)",
  "version": "1.0.0",
  "description": "Instantly detect finished games on Chess.com and analyze them on Lichess with one click or automatic import.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.chess.com/*",
    "*://*.lichess.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.chess.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chess Analysis Bridge"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
